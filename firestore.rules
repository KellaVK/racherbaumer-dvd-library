rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isSignedIn()  { return request.auth != null; }
    function uid()         { return request.auth.uid; }
    function isAdmin() {
      return isSignedIn() &&
             (request.auth.token.email in ['kruebbe527@gmail.com', 'kellakruebbe@gmail.com'] ||
              (exists(/databases/$(database)/documents/users/$(uid())) &&
               get(/databases/$(database)/documents/users/$(uid())).data.get('role', '') == 'admin'));
    }
    function isApproved() {
      return isSignedIn() &&
             (request.auth.token.email in ['kruebbe527@gmail.com', 'kellakruebbe@gmail.com'] ||
              (exists(/databases/$(database)/documents/users/$(uid())) &&
               get(/databases/$(database)/documents/users/$(uid())).data.get('role', '') in ['approved', 'admin']));
    }

    // ── DVDs ───────────────────────────────────────────────────────────────
    // Anyone (even unauthenticated) can read the catalogue
    match /dvds/{dvdId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Checkouts ──────────────────────────────────────────────────────────
    match /checkouts/{checkoutId} {
      // Users can read their own checkouts; admins see all
      allow read:   if (isSignedIn() && resource.data.requesterId == uid()) || isAdmin();
      // Approved users can create a request for themselves
      allow create: if isApproved()
                    && request.resource.data.requesterId == uid()
                    && request.resource.data.status in ['pending', 'queued']
                    && existsAfter(/databases/$(database)/documents/openRequests/$(request.resource.data.dvdId + '_' + uid()));
      // Only admins can change status (approve / deny / return)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // One lock per DVD and borrower prevents duplicate open requests. The
    // checkout history remains in /checkouts after the lock is removed.
    match /openRequests/{requestId} {
      allow read: if (isSignedIn() && resource.data.requesterId == uid()) || isAdmin();
      allow create: if isApproved()
                    && request.resource.data.requesterId == uid()
                    && request.resource.data.status in ['pending', 'queued']
                    && existsAfter(/databases/$(database)/documents/checkouts/$(request.resource.data.checkoutId));
      allow update, delete: if isAdmin();
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile; admins read all
      allow read:   if isSignedIn() && (userId == uid() || isAdmin());
      // New user document created on registration — allow self-create
      allow create: if isSignedIn() && userId == uid();
      // Only admins can change roles
      allow update: if (isAdmin() && (userId != uid() || request.resource.data.role == resource.data.role))
                    || (isSignedIn() && userId == uid()
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }
  }
}
